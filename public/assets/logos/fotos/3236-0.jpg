function check_buscador_up() {
      var events =  jQuery._data(jQuery('#wpsl-search-btn').get(0), "events");
      if (events) {
           jQuery('#wpsl-search-btn').click();
      } else {
            setTimeout(check_buscador_up, 100);
      }
}


// Mostrar xarxes socials quan estiguin creades
jQuery(document).ready(function() {
 if(document.getElementById('xarxes_socials') != null) {
     jQuery('div#cont_xarxes').append(jQuery('#xarxes_socials'));
 }
});


jQuery(document).ready(function() {
   
    // Si estem cercant una poblacio llavors omplim formulari i llancem cerca Ajax del plug-in de Botigues
    var url_string =window.location.href ;
    var url = new URL(url_string);
    var c = url.searchParams.get("poblacion");

   if (c) {
       jQuery('#wpsl-search-input').val(c);
       //jQuery('#wpsl-radius-dropdown').val(25);
       setTimeout(check_buscador_up, 100);
   }
   
   // Listener pel botó del mini formulari de cerca d'optiques.
   jQuery('#btn_buscar_opticas').on('click', function(evt) {
        evt.preventDefault();
        var poblacion = jQuery('#poblacion').val();  
        window.location.href = "https://www.ugotuopticaamiga.es/encuentra-tu-optica?poblacion=" + poblacion;
   });

   path =window.location.pathname;

   // Preguntem ubicació (si no ho hem fet abans) i mostrem botigues mes properes
   geo_localitzacio();

   // Si estem a una fitxa de òptica - Ens la guardem per poder-la mostar
   if (path.startsWith('/optica/')) {
       path = path.replace('/optica/','');
       path = path.replace('/','');
       set_optica(path);
   } else {
      // No estem en una fitxa, per tant mostrem la òptica
      mostrar_optica();
   }
});

// Determina que cal fer si encara no tenim ubicació.
function geo_localitzacio() {   
        if (!tenim_coordenades()) {
              geolocalization_dialog();
        } else {
              // Si ok demanar opticas_cercanas per coordeandes - Passem 0 per que ja estan a la sessió.
              mostrar_botigues_properes(0,0);
        }
}

// Obre el dialeg per preguntar la ubicació.
/*function geolocalization_dialog() {
  jQuery('body').append( '<div id="myModal" class="ebs_modal"> <div class="ebs_modal-content">  <span class="ebs_close">&times;</span> <h3>Tu ubicación</h3><p>Por favor indícanos desde qué población nos visitas:</p><div><input id="search-box" type="text" name="pob"><input type="hidden" value="0" id="lat" name="lat"><input type="hidden" value="0" id="lng" name="lng"> <button id="btn_ebs_aceptar" class="ebs_button" disabled>Aceptar</button><button class="ebs_button" id="btn_ebs_omitir">Omitir</button></div><div id="suggesstion-box"></div></div></div>');
  //alert('done');
  jQuery('#myModal').css('display','block');
  jQuery('.ebs_close').click(function() {
         jQuery('#myModal').remove();
  });*/

  // Acceptem una ubicació. Guardem ubicació i mostrem botigues mes properes
  jQuery('#btn_ebs_aceptar').click(function() {
         // Fixar coordenades a 0
         var lat = jQuery('#lat').val();
         var lng = jQuery('#lng').val();
         mostrar_botigues_properes(lat,lng);
         jQuery('#myModal').remove();
  });

 // Tanquem dialeg i fixem que el usuari  no vol compartir la seva ubicació. Mostrem optiques de Madrid i BCN
 jQuery('#btn_ebs_omitir').click(function() {
         //Agafar coordenades
         mostrar_botigues_properes(0,0);
         jQuery('#myModal').remove();
  });

 // AJAX call for autocomplete - Busca llista de poblacions que coincideixen amb el text entrat
jQuery(document).ready(function(){
	jQuery("#search-box").keyup(function(){
               jQuery('#btn_ebs_aceptar').prop('disabled', true);
               jQuery('#btn_ebs_aceptar').css('background-color', 'lightgray');

               if (jQuery("#search-box").val().length <= 3) {
	  	      jQuery("#suggesstion-box").hide();
                      return;
                }

		jQuery.ajax({
		type: "POST",
		url: "/ebs/poblaciones.php",
		data:'keyword='+jQuery(this).val(),
		beforeSend: function(){
			jQuery("#search-box").css("background","#FFF url(LoaderIcon.gif) no-repeat 165px");
		},
		success: function(data){
                        if (data.length > 0) {
    			    jQuery("#suggesstion-box").show();
			    jQuery("#suggesstion-box").html(data);
			    jQuery("#search-box").css("background","#FFF");
                        } else {
                           jQuery("#suggesstion-box").hide();
                        }
		}
		});
	});
});

}

jQuery(document).ready(function(){
	jQuery("#ciudad-box").keyup(function(){
            
               if (jQuery("#ciudad-box").val().length <= 3) {
	  	            jQuery("#suggesstion-box2").hide();
                      return;
                }

             jQuery.ajax({
		type: "POST",
		url: "/ebs/poblaciones.php?funcio=selecciona_poblacio",
		data:'keyword='+jQuery(this).val(),
		beforeSend: function(){
			//jQuery("#search-box").css("background","#FFF url(LoaderIcon.gif) no-repeat 165px");
		},
		success: function(data){
                        if (data.length > 0) {
    			    jQuery("#suggesstion-box2").show();
			    jQuery("#suggesstion-box2").html(data);
			    jQuery("#search-box").css("background","#FFF");
                        } else {
                           jQuery("#suggesstion-box2").hide();
                        }
		}
		});
               
                    
	});
});

function selecciona_poblacio(val,lat,lng) {
        jQuery("#ciudad-box").val(val);
        jQuery("#suggesstion-box2").hide();

        var params = "?la="+lat+'&lo='+lng+'&num=25';

         jQuery.ajax({
		type: "GET",
		url: "/ebs/opticas_cercanas.php"+params,
		success: function(data){
                        //alert(data);
                        json = JSON.parse(data);
                        var div = jQuery('.formRowOptica');
                        var str_html = '<select name="optica" id="optica" style="width: 80%;">';
                        str_html += '<option value="Selecciona la óptica" disabled selected>Selecciona la óptica</option>';
                        for (var i = 0; i<json.length; i++) {
                             str_html+= '<option value="'+json[i]['ID']+'">'+json[i]['post_title']+'('+json[i]['wpsl_city']+')</option>';
                       }
                       str_html += '</select>';
                       div.html(str_html);
		}
         });
}



// Quan seleccionem una població guardem la latitud en camps hidden 
function selectPoblacion(val,lat,lng) {
    // alert('selectPoblacion: '+lat+','+lng);
    jQuery("#lat").val(lat);
    jQuery("#lng").val(lng);
    jQuery("#search-box").val(val);
    jQuery("#suggesstion-box").hide();
    jQuery('#btn_ebs_aceptar').prop('disabled', false);
    jQuery('#btn_ebs_aceptar').css('background-color', ' #b1b100');
}

/* Mostrem les botigues properes*/
function mostrar_botigues_properes(lat,lng) {
         // Si ens passen coordenades les fixem a la sessió i obtenim botigues
         var params = "?la="+lat+'&lo='+lng;

         // Si ens passen coordenades 0 llavors fer servir el que tinguem a la sessió.
         // Si no en tenim llavors agafem les de BCN i Madrid 
         if (lat=='0') params = '';

         jQuery.ajax({
		type: "GET",
		url: "/ebs/opticas_cercanas.php"+params,
		success: function(data){
                        //alert(data);
                        json = JSON.parse(data);
                        var div  =jQuery('.opticas_cerca').last();
                        for (var i = 0; i<json.length; i++) {
                           div.append('<div class="optica_cerca_tuyo"><div class="optica_cerca_img"><img src="https://ugotuopticaamiga.es/contenido//tienda_'+json[i]['ID']+'.jpg" onerror="imgError(this);"></div><div class="optica_cerca_p"><p><span>'+json[i]['post_title']+'</span></p>  <p>'+json[i]['wpsl_address']+'</p><p>'+json[i]['wpsl_city']+'</p><button onclick="goto_href(\'https://www.ugotuopticaamiga.es/optica/'+json[i]['post_name']+'\')" class="btnResLoc2">Visita su web</button></div></div>');
                       }
		}
         });
}

function imgError(image) {
    image.onerror = "";
    image.src = "https://ugotuopticaamiga.es/contenido//not_found.png";
    return true;
}

function goto_href(url) {
     location.href=url;
}

/* Mirem si tenim coordenades - true si en tenim*/
function tenim_coordenades() {
        var tenim = false;
        jQuery.ajax({
		type: "GET",
                data:'',
                async:false,
		url: "/ebs/opticas_cercanas.php?coords=true",
		success: function(data){
                        json = JSON.parse(data);
                       
                        tenim = (json["res"] == 'OK');
                       //alert('tenim_coordenades? '+json["res"]+' - '+tenim);
		}
         });
         
         return tenim;
}

/* Guarda el nom i permalink de la òptica */
function  set_optica(optica){
          jQuery.ajax({
		type: "GET",
                data:'',
                async:false,
		url: "/ebs/ultima_visita.php?optica="+optica,
		success: function(data){
                       jQuery('#id_optica').val(data);
                       //alert('ultima_visita ok ' +optica);
		}
         });
}

/* Mostra la darrera òptica visitada */
function  mostrar_optica(){
          jQuery.ajax({
		type: "GET",
                data:'',
                async:false,
		url: "/ebs/ultima_visita.php",
		success: function(data){
                     if(data != '') {
                     
                       json = JSON.parse(data);
                       var div  =jQuery('#centro_optico').last();
                       html = '<div id="mi_optica" class="mi_optica">Te encuentras en la óptica <a style="color: #B5B50D;" href="https://www.ugotuopticaamiga.es/optica/'+json['permalink']+'"> '+json['nombre']+' - '+json['wpsl_city']+'</a></div>';
                       //alert(html);
                       div.append(html);
                    }
		}
         });
}


</script><link rel="stylesheet" id="et-divi-customizer-global-cached-inline-styles" href="https://ugotuopticaamiga.es/wp-content/cache/et/global/et-divi-customizer-global-15895552218045.min.css" onerror="et_core_page_resource_fallback(this, true)" onload="et_core_page_resource_fallback(this)" /><style id="tt-easy-google-font-styles" type="text/css">p { color: #787a7b; font-family: 'Open Sans'; font-style: normal; font-weight: 300; text-decoration: none; text-transform: none; }
